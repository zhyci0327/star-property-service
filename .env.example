# Power Automate HTTP Request Trigger Webhook URL
# Obtain this URL from your Power Automate flow ("When an HTTP request is received")
# Copy this file to .env.local for local development, and configure in Vercel Project Settings for production
POWER_AUTOMATE_WEBHOOK_URL=https://prod-xx.australiasoutheast.logic.azure.com:443/workflows/your-workflow-id/triggers/manual/paths/invoke?api-version=2016-06-01
